{
  "name": "yatoro-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:dev": "bun run scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/database/migrate.ts",
    "db:seed": "bun run src/database/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/static": "^1.4.10",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "elysia-rate-limit": "^4.6.3",
    "file-type": "^22.1.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.4.2",
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
