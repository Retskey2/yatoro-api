# Runtime
NODE_ENV=development
PORT=5084
LOG_LEVEL=info

# Database
# Works as-is with `bun run db:dev` (PGlite over the Postgres protocol, no Docker needed).
# For a real server: postgresql://yatoro:yatoro@localhost:5432/yatoro
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_POOL_MAX=10

# Auth — secret must be at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=1h

# HTTP
# Comma-separated list of allowed frontend origins (5084: the demo page served by the API itself)
CORS_ORIGINS=http://localhost:3000,http://localhost:5084
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# Storage
UPLOADS_DIR=uploads

# S3-compatible object storage for videos (optional; without it video endpoints answer 503).
# `docker compose up` configures it for the containers itself. To use the compose SeaweedFS
# from `bun run dev`, start only it (`docker compose up seaweedfs`) and uncomment:
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=yatoro-dev
# S3_SECRET_ACCESS_KEY=yatoro-dev-secret-change-me
# S3_BUCKET=yatoro-media

# Seed (`bun run db:seed`) — local development admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@yatoro.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Catalog import (`bun run catalog:import`) — identify the app to Shikimori
SHIKIMORI_USER_AGENT=Yatoro
