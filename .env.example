# Runtime
NODE_ENV=development
PORT=5084
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/yatoro

# Auth — secret must be at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ACCESS_TTL=1h

# HTTP
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# Storage
UPLOADS_DIR=uploads
